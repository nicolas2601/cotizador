# ===== DJANGO =====
# Use example values here. Replace with real secrets in your real `.env` (not checked into git).
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== BASE DE DATOS (Supabase Session Pooler) =====
# Example DATABASE_URL format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://example_user:example_password@db.example.com:5432/example_db
DB_USER=example_user
DB_PASSWORD=example_password
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=example_db

# ===== SUPABASE =====
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=example_anon_key
SUPABASE_SERVICE_ROLE_KEY=example_service_role_key

# ===== OLLAMA CLOUD (IA Tikno) =====
OLLAMA_CLOUD_API_KEY=your_ollama_api_key
OLLAMA_CLOUD_BASE_URL=https://api.ollama.com/v1
OLLAMA_MODEL=minimax-m2.5:cloud

# ===== UPSTASH REDIS =====
# Example UPSTASH/REDIS URLs/tokens - replace with your own in production
REDIS_URL=rediss://default:example_redis_token@redis.example.com:6379
UPSTASH_REDIS_REST_URL="https://redis.example.com"
UPSTASH_REDIS_REST_TOKEN="example_upstash_token"

# ===== EMAIL (Configuración) =====
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=example@example.com
EMAIL_HOST_PASSWORD=changeme
DEFAULT_FROM_EMAIL=Example <noreply@example.com>

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
